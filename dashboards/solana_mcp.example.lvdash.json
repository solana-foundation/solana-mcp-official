{
  "datasets": [
    {
      "name": "corpus_totals",
      "displayName": "Corpus totals",
      "queryLines": [
        "SELECT\n",
        "  count(*) AS total_chunks,\n",
        "  count(DISTINCT url) AS distinct_urls,\n",
        "  count(DISTINCT source_id) AS sources,\n",
        "  max(fetched_at) AS last_fetch\n",
        "FROM docs_chunks"
      ]
    },
    {
      "name": "chunks_per_source",
      "displayName": "Chunks per source",
      "queryLines": [
        "SELECT source_id, count(*) AS chunks\n",
        "FROM docs_chunks\n",
        "GROUP BY source_id\n",
        "ORDER BY chunks DESC"
      ]
    },
    {
      "name": "freshness",
      "displayName": "Corpus freshness (weekly)",
      "queryLines": [
        "SELECT date_trunc('week', fetched_at) AS week, count(*) AS chunks\n",
        "FROM docs_chunks\n",
        "GROUP BY 1 ORDER BY 1"
      ]
    },
    {
      "name": "tool_calls_daily",
      "displayName": "Tool calls per day",
      "queryLines": [
        "SELECT date(timestamp) AS day, tool_name, count(*) AS calls\n",
        "FROM mcp_tool_calls\n",
        "WHERE row_type = 'response'\n",
        "GROUP BY 1, 2 ORDER BY 1"
      ]
    },
    {
      "name": "top_queries",
      "displayName": "Top 50 queries",
      "queryLines": [
        "SELECT regexp_replace(arguments, '^\"|\"$', '') AS q, count(*) AS calls\n",
        "FROM mcp_tool_calls\n",
        "WHERE row_type = 'response' AND arguments IS NOT NULL\n",
        "GROUP BY 1 ORDER BY 2 DESC LIMIT 50"
      ]
    },
    {
      "name": "clients",
      "displayName": "Clients",
      "queryLines": [
        "SELECT client_name, client_version, count(*) AS handshakes\n",
        "FROM mcp_initializations\n",
        "GROUP BY 1, 2 ORDER BY 3 DESC"
      ]
    },
    {
      "name": "fp_rate_per_rule",
      "displayName": "FP rate per rule (30d)",
      "queryLines": [
        "WITH runs AS (\n",
        "  SELECT from_json(response_text, 'STRUCT<rules: ARRAY<STRING>, dismissed_rules: ARRAY<STRING>>') AS r\n",
        "  FROM mcp_tool_calls\n",
        "  WHERE row_type = 'response' AND tool_name = 'program_autofixer'\n",
        "    AND timestamp >= current_timestamp() - INTERVAL 30 DAYS\n",
        "    AND response_text IS NOT NULL\n",
        ")\n",
        "SELECT rule,\n",
        "  count(*) AS fired_runs,\n",
        "  count_if(array_contains(r.dismissed_rules, rule)) AS dismissed_runs,\n",
        "  round(count_if(array_contains(r.dismissed_rules, rule)) * 100.0 / count(*), 1) AS fp_rate_pct\n",
        "FROM runs LATERAL VIEW explode(r.rules) exploded AS rule\n",
        "GROUP BY rule\n",
        "ORDER BY fp_rate_pct DESC, fired_runs DESC"
      ]
    },
    {
      "name": "fp_blind_spots",
      "displayName": "Dismissal blind spots (30d)",
      "queryLines": [
        "WITH counts AS (\n",
        "  SELECT from_json(get_json_object(response_text, '$.dismissed_hint_counts'), 'MAP<STRING, MAP<STRING, INT>>') AS m\n",
        "  FROM mcp_tool_calls\n",
        "  WHERE row_type = 'response' AND tool_name = 'program_autofixer'\n",
        "    AND timestamp >= current_timestamp() - INTERVAL 30 DAYS\n",
        ")\n",
        "SELECT rule, hint_condition, sum(n) AS dismissals\n",
        "FROM counts\n",
        "LATERAL VIEW explode(m) rules_map AS rule, buckets\n",
        "LATERAL VIEW explode(buckets) bucket_map AS hint_condition, n\n",
        "GROUP BY rule, hint_condition\n",
        "ORDER BY rule, dismissals DESC"
      ]
    }
  ],
