# Endpoints under test as name=url pairs (full MCP streamable-HTTP URLs,
# typically ending in /mcp). Also settable per run via --endpoint flags.
EVAL_ENDPOINTS=prod=https://mcp.solana.com/mcp,mine=https://my-mcp.example.com/mcp

# Optional bearer token per endpoint: EVAL_TOKEN_<NAME> (name uppercased,
# dashes to underscores).
EVAL_TOKEN_PROD=
EVAL_TOKEN_MINE=

# Which MCP tool to exercise. Solana_Documentation_Search is the search
# tool; Solana_Expert__Ask_For_Help is the Q&A tool.
EVAL_TOOL=Solana_Documentation_Search

# Output directory. Defaults to eval/results/<iso-ts>.
EVAL_OUT=
